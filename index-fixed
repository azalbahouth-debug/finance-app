.set-sec{margin-bottom:18px}
.set-sec-t{font-size:11px;font-weight:700;color:var(--t3);letter-spacing:.05em;text-transform:uppercase;margin-bottom:7px}
.set-help{font-size:11px;color:var(--t3);margin:-8px 0 10px;padding:0 2px;line-height:1.5}
.modal-btns{display:flex;gap:10px}
.modal-btns .sub-btn{flex:1}
.modal-btns .sub-btn:first-child{background:var(--muted);color:var(--t2);box-shadow:none}
/* ══ DEMO BAR ══ */
.demo-bar{display:none;background:var(--warn-soft);border-bottom:1px solid rgba(245,158,11,.2);padding:5px 16px;font-size:11px;font-weight:600;color:var(--warn);text-align:center}
/* ══ TOAST ══ */
.toast{position:fixed;bottom:calc(var(--safe-b) + 88px);left:50%;transform:translateX(-50%) translateY(12px);background:var(--raised);border:1px solid var(--bd2);border-radius:var(--r-lg);padding:11px 20px;font-size:13px;font-weight:600;z-index:300;opacity:0;transition:all var(--dur) var(--ease);white-space:nowrap;pointer-events:none;box-shadow:var(--sh-lg);color:var(--t1)}
