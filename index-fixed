      <div id="resend" class="resend"></div>
      <button class="auth-btn" style="margin-top:16px" onclick="A.verify()" id="btn-verify">تحقق والدخول</button>
      <button class="auth-btn" style="margin-top:8px;background:var(--muted);color:var(--t2);box-shadow:none" onclick="A.back()" id="btn-back">رجوع</button>
    </div>
  </div>

  <div class="auth-toggles">
    <button class="auth-toggle-btn" onclick="toggleLang()">EN / عر</button>
    <button class="auth-toggle-btn" onclick="toggleTheme()">☀️ / 🌙</button>
  </div>
</div>

