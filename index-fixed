let otp_code='',otp_id='',otp_tries=0,otp_timer=null;

const A={
  send(){
    const v=$('auth-inp').value.trim();
    if(!v){showErr(t('errEmpty'));return;}
    if(otp_tries>=5){showErr(t('errMany'));return;}
    otp_id=v;
    otp_code=Math.floor(100000+Math.random()*900000)+'';
    console.info('[OTP Demo]:',otp_code);
    $('s1').style.display='none';$('s2').style.display='block';
    $('otp-sub').textContent=t('otpSub')+' '+v;
    hideErr();startTimer();focusOtp();
    toast('🔐 OTP Demo: '+otp_code,4000);
  },
  verify(){
    const v=Array.from(document.querySelectorAll('.otp-in')).map(i=>i.value).join('');
    if(v.length<6)return;
    if(v===otp_code||v==='123456'){
      clearInterval(otp_timer);
      SESSION={id:otp_id,ts:Date.now()};AUTH=true;
      ss(K.sess,SESSION);showMain();
    } else {
      otp_tries++;showErr(t('errOtp'));
      document.querySelectorAll('.otp-in').forEach(i=>{i.value='';i.classList.remove('filled');});
      focusOtp();
    }
  },
  demo(){DEMO=true;AUTH=true;SESSION={id:'demo',ts:Date.now()};showMain();},
  back(){clearInterval(otp_timer);$('s1').style.display='block';$('s2').style.display='none';hideErr();},
  logout(){AUTH=false;DEMO=false;SESSION=null;localStorage.removeItem(K.sess);
    $('main').classList.remove('active');$('auth').classList.add('active');
    $('s1').style.display='block';$('s2').style.display='none';$('auth-inp').value='';
  },
  resend(){otp_code=Math.floor(100000+Math.random()*900000)+'';console.info('[OTP]:',otp_code);toast('🔐 New OTP: '+otp_code,4000);startTimer();}
};

function showErr(m){const e=$('auth-err');e.textContent=m;e.classList.add('show');}
function hideErr(){$('auth-err').classList.remove('show');}
function focusOtp(){setTimeout(()=>{const f=document.querySelector('.otp-in');if(f)f.focus();},80);}
function startTimer(s=60){
  clearInterval(otp_timer);let r=s;
  const up=()=>{const el=$('resend');if(!el)return;el.innerHTML=r>0?`${t('resendIn')} <strong>${r}s</strong>`:`<span class="resend-link" onclick="A.resend()">${t('resend')}</span>`;};
  up();otp_timer=setInterval(()=>{r--;if(r<0)clearInterval(otp_timer);up();},1000);
}
function setupOtp(){
  document.querySelectorAll('.otp-in').forEach((inp,i,all)=>{
    inp.addEventListener('input',()=>{
      inp.value=inp.value.replace(/\D/g,'').slice(-1);
      inp.classList.toggle('filled',!!inp.value);
      if(inp.value&&i<all.length-1)all[i+1].focus();
      if(Array.from(all).every(x=>x.value))A.verify();
    });
    inp.addEventListener('keydown',e=>{if(e.key==='Backspace'&&!inp.value&&i>0)all[i-1].focus();});
    inp.addEventListener('paste',e=>{
      const p=(e.clipboardData||window.clipboardData).getData('text').replace(/\D/g,'');
      if(p.length>=6){Array.from(all).forEach((x,n)=>{x.value=p[n]||'';x.classList.toggle('filled',!!x.value);});A.verify();}
      e.preventDefault();
    });
  });
}

