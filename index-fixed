        <input class="otp-in" type="tel" maxlength="1" inputmode="numeric">
        <input class="otp-in" type="tel" maxlength="1" inputmode="numeric">
        <input class="otp-in" type="tel" maxlength="1" inputmode="numeric">
        <input class="otp-in" type="tel" maxlength="1" inputmode="numeric">
        <input class="otp-in" type="tel" maxlength="1" inputmode="numeric">
        <input class="otp-in" type="tel" maxlength="1" inputmode="numeric">
