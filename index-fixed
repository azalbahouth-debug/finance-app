<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="ماليتي">
<meta name="theme-color" content="#2563EB" id="theme-meta">
<meta name="description" content="ماليتي — لوحة تحكم مالية شخصية">
<title>ماليتي</title>
<link rel="manifest" href="./manifest.json">
<link rel="apple-touch-icon" href="./icon-192.png">
<link rel="icon" href="./icon-192.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Tajawal:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
/* ══ RESET ══ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;-webkit-font-smoothing:antialiased}
/* ══ TOKENS ══ */
:root{
--brand:#2563EB;--brand-l:#3B82F6;--brand-d:#1D4ED8;--brand-soft:rgba(37,99,235,.10);
--ok:#10B981;--ok-soft:rgba(16,185,129,.10);
--warn:#F59E0B;--warn-soft:rgba(245,158,11,.10);
--err:#EF4444;--err-soft:rgba(239,68,68,.10);
--r-xs:6px;--r-sm:10px;--r-md:14px;--r-lg:18px;--r-xl:24px;--r-2xl:32px;
--sh-sm:0 1px 4px rgba(0,0,0,.06);--sh-md:0 4px 20px rgba(0,0,0,.08);--sh-lg:0 8px 40px rgba(0,0,0,.12);
--sh-brand:0 6px 24px rgba(37,99,235,.30);
--ease:cubic-bezier(.4,0,.2,1);--spring:cubic-bezier(.34,1.56,.64,1);
--dur:200ms;--safe-t:env(safe-area-inset-top,44px);--safe-b:env(safe-area-inset-bottom,20px);
}
[data-theme=light]{
--bg:#F0F4FF;--surf:#FFFFFF;--raised:#FFFFFF;--muted:#EEF2FF;
--hover:rgba(0,0,0,.04);--press:rgba(0,0,0,.08);
--bd:rgba(0,0,0,.07);--bd2:rgba(0,0,0,.12);
--t1:#0F172A;--t2:#3D5280;--t3:#94A3B8;
--nav-bg:rgba(240,244,255,.94);--card-sh:0 2px 12px rgba(37,99,235,.06),0 1px 3px rgba(0,0,0,.05);
}
[data-theme=dark]{
--bg:#070B14;--surf:#0D1424;--raised:#131B2E;--muted:#192338;
--hover:rgba(255,255,255,.05);--press:rgba(255,255,255,.09);
--bd:rgba(255,255,255,.07);--bd2:rgba(255,255,255,.12);
--t1:#E8EEFF;--t2:#7B8EAE;--t3:#3D4E6A;
--nav-bg:rgba(7,11,20,.94);--card-sh:0 4px 24px rgba(0,0,0,.45);
}
/* ══ BASE ══ */
html{height:100%;background:var(--bg)}
body{min-height:100%;background:var(--bg);color:var(--t1);font-family:'Plus Jakarta Sans',sans-serif;font-size:15px;line-height:1.5;overflow-x:hidden;transition:background var(--dur) var(--ease),color var(--dur) var(--ease)}
body[dir=rtl]{font-family:'Tajawal',sans-serif}
::-webkit-scrollbar{width:3px;height:3px}::-webkit-scrollbar-thumb{background:var(--bd2);border-radius:3px}
/* ══ LAYOUT ══ */
#app{display:flex;flex-direction:column;min-height:100vh}
.screen{display:none;flex-direction:column;min-height:100vh}.screen.active{display:flex}
.auth-wrap{display:none;flex-direction:column;align-items:center;justify-content:center;min-height:100vh;padding:32px 20px calc(var(--safe-b)+32px);background:var(--bg)}.auth-wrap.active{display:flex}
/* ══ AUTH ══ */
.auth-logo{width:68px;height:68px;border-radius:22px;background:var(--brand);display:flex;align-items:center;justify-content:center;font-size:32px;font-weight:700;color:#fff;margin-bottom:18px;box-shadow:var(--sh-brand);animation:popIn .6s var(--spring) both}
@keyframes popIn{from{opacity:0;transform:scale(.4) rotate(-12deg)}}
.auth-title{font-size:28px;font-weight:700;margin-bottom:6px;text-align:center}
.auth-sub{font-size:14px;color:var(--t2);margin-bottom:32px;text-align:center}
.auth-box{width:100%;max-width:400px;background:var(--surf);border:1px solid var(--bd);border-radius:var(--r-xl);padding:28px 22px;box-shadow:var(--sh-md)}
.form-lbl{font-size:12px;font-weight:600;color:var(--t2);margin-bottom:6px;display:block}
.form-inp{width:100%;padding:13px 16px;background:var(--muted);border:1.5px solid var(--bd);border-radius:var(--r-md);color:var(--t1);font-size:15px;font-family:inherit;outline:none;transition:all var(--dur);margin-bottom:14px}
.form-inp:focus{border-color:var(--brand);background:var(--surf);box-shadow:0 0 0 3px var(--brand-soft)}
.form-inp::placeholder{color:var(--t3)}
.auth-btn{width:100%;height:52px;background:var(--brand);border:none;border-radius:var(--r-md);color:#fff;font-size:16px;font-weight:700;font-family:inherit;cursor:pointer;box-shadow:var(--sh-brand);transition:all var(--dur);margin-top:4px}
.auth-btn:hover{background:var(--brand-l);transform:translateY(-1px)}.auth-btn:active{transform:scale(.98)}.auth-btn:disabled{opacity:.4;cursor:not-allowed;transform:none}
.auth-err{font-size:12px;color:var(--err);background:var(--err-soft);border:1px solid rgba(239,68,68,.2);border-radius:var(--r-sm);padding:9px 12px;margin-bottom:14px;display:none}
.auth-err.show{display:block;animation:shake .4s}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
.otp-row{display:flex;gap:8px;justify-content:center;margin-bottom:14px}
.otp-in{width:48px;height:56px;text-align:center;font-size:22px;font-weight:700;font-family:inherit;background:var(--muted);border:2px solid var(--bd);border-radius:var(--r-md);color:var(--t1);outline:none;transition:all var(--dur)}
.otp-in:focus{border-color:var(--brand);background:var(--surf);box-shadow:0 0 0 3px var(--brand-soft)}
.otp-in.filled{border-color:var(--brand);color:var(--brand)}
.resend{text-align:center;font-size:13px;color:var(--t3);margin-top:10px}
.resend-link{color:var(--brand);font-weight:600;cursor:pointer}
.auth-alt{text-align:center;margin-top:18px;font-size:13px;color:var(--t3)}
.auth-alt-link{color:var(--brand);font-weight:600;cursor:pointer}
.auth-toggles{display:flex;gap:10px;margin-top:22px}
.auth-toggle-btn{padding:6px 16px;font-size:12px;color:var(--t2);background:var(--surf);border:1px solid var(--bd);border-radius:99px;cursor:pointer;font-family:inherit;transition:all var(--dur)}
.auth-toggle-btn:hover{border-color:var(--bd2);color:var(--t1)}
/* ══ NAV ══ */
.nav{position:sticky;top:0;z-index:80;padding:calc(var(--safe-t) + 8px) 18px 12px;background:var(--nav-bg);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border-bottom:1px solid var(--bd);display:flex;align-items:center;justify-content:space-between;gap:10px;transition:background var(--dur)}
.nav-brand{display:flex;align-items:center;gap:9px;cursor:pointer;user-select:none}
.nav-icon{width:34px;height:34px;border-radius:var(--r-sm);background:var(--brand);display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:700;color:#fff;flex-shrink:0}
.nav-name{font-size:16px;font-weight:700;color:var(--t1)}
.nav-name span{color:var(--brand)}
.nav-pill{font-size:12px;font-weight:600;color:var(--brand);background:var(--brand-soft);padding:5px 13px;border-radius:99px;border:1px solid rgba(37,99,235,.15);white-space:nowrap;cursor:pointer;transition:all var(--dur)}
.nav-pill:hover{background:rgba(37,99,235,.15)}
.nav-acts{display:flex;gap:7px}
.nav-btn{width:36px;height:36px;border-radius:50%;border:1px solid var(--bd);background:var(--surf);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:15px;color:var(--t2);transition:all var(--dur);box-shadow:var(--sh-sm)}
.nav-btn:hover{background:var(--muted);border-color:var(--bd2)}.nav-btn:active{transform:scale(.9)}
.spin{animation:spin .9s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
/* ══ SYNC BAR ══ */
.sync-bar{height:3px;background:var(--brand);transform:scaleX(0);transform-origin:left;transition:transform .8s var(--ease);position:fixed;top:0;left:0;right:0;z-index:100}
[dir=rtl] .sync-bar{transform-origin:right}
.sync-bar.load{transform:scaleX(.6)}.sync-bar.done{transform:scaleX(1);opacity:0;transition:transform .3s,opacity .4s .3s}
/* ══ TABS ══ */
.tabs{display:flex;gap:6px;padding:13px 16px 0;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;background:var(--bg);transition:background var(--dur)}
.tabs::-webkit-scrollbar{display:none}
.tab{flex-shrink:0;padding:8px 16px;border-radius:99px;font-size:13px;font-weight:600;border:1px solid var(--bd);background:var(--surf);color:var(--t2);cursor:pointer;transition:all var(--dur);white-space:nowrap;box-shadow:var(--sh-sm)}
.tab:hover{border-color:var(--bd2);color:var(--t1)}.tab.on{background:var(--brand);border-color:var(--brand);color:#fff;box-shadow:var(--sh-brand)}.tab:active{transform:scale(.95)}
/* ══ SCROLL ══ */
.scroll{flex:1;padding:0 16px calc(var(--safe-b) + 90px);overflow-y:auto;-webkit-overflow-scrolling:touch}
/* ══ PAGES ══ */
.page{display:none;animation:fadeUp var(--dur) var(--ease) both}.page.on{display:block}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}}
/* ══ SECTION ══ */
.sec{margin-top:20px}
.sec-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;padding:0 2px}
.sec-ttl{font-size:11px;font-weight:700;color:var(--t3);letter-spacing:.07em;text-transform:uppercase}
.sec-more{font-size:12px;font-weight:600;color:var(--brand);cursor:pointer}
/* ══ HERO ══ */
.hero{background:var(--surf);border:1px solid var(--bd);border-radius:var(--r-xl);padding:22px;margin-top:16px;box-shadow:var(--card-sh);position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;top:-70px;right:-50px;width:220px;height:220px;background:radial-gradient(circle,rgba(37,99,235,.08) 0%,transparent 70%);pointer-events:none}
[data-theme=dark] .hero::before{background:radial-gradient(circle,rgba(37,99,235,.14) 0%,transparent 70%)}
.hero-lbl{font-size:12px;color:var(--t3);margin-bottom:6px;font-weight:500}
.hero-amt{font-size:46px;font-weight:700;letter-spacing:-2px;line-height:1;margin-bottom:4px;transition:color var(--dur)}
.hero-amt .cur{font-size:20px;font-weight:400;color:var(--t3);vertical-align:super}
.hero-sub{font-size:12px;color:var(--t3);margin-bottom:20px}
.chips{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.chip{background:var(--muted);border:1px solid var(--bd);border-radius:var(--r-md);padding:12px 6px;text-align:center;transition:all var(--dur)}
.chip-v{font-size:14px;font-weight:700;margin-bottom:3px}
.chip-l{font-size:9px;color:var(--t2);line-height:1.4}
/* ══ KPI ══ */
.kpis{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.kpi{background:var(--surf);border:1px solid var(--bd);border-radius:var(--r-lg);padding:16px;cursor:pointer;transition:all var(--dur);box-shadow:var(--card-sh);position:relative;overflow:hidden}
.kpi::after{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--kc,var(--brand))}
[dir=rtl] .kpi::after{left:0;right:0}
.kpi:hover{transform:translateY(-2px);box-shadow:var(--sh-md)}.kpi:active{transform:scale(.97)}
.kpi-ic{font-size:22px;margin-bottom:9px}
.kpi-v{font-size:19px;font-weight:700;line-height:1;margin-bottom:4px}
.kpi-l{font-size:11px;color:var(--t2);margin-bottom:3px;font-weight:500}
.kpi-n{font-size:10px;color:var(--t3)}
/* ══ ALERT ══ */
.alert{border-radius:var(--r-md);padding:12px 14px;margin-bottom:8px;display:flex;gap:10px;align-items:flex-start;border:1px solid;animation:fadeUp var(--dur) var(--ease)}
.a-ok{background:var(--ok-soft);border-color:rgba(16,185,129,.2)}
.a-warn{background:var(--warn-soft);border-color:rgba(245,158,11,.2)}
.a-err{background:var(--err-soft);border-color:rgba(239,68,68,.2)}
.a-info{background:var(--brand-soft);border-color:rgba(37,99,235,.2)}
.al-ic{font-size:18px;flex-shrink:0;margin-top:1px}
.al-t{font-size:13px;font-weight:600;margin-bottom:2px}
.al-s{font-size:11px;color:var(--t2);line-height:1.5}
/* ══ DEBT ══ */
.dcard{background:var(--surf);border:1px solid var(--bd);border-radius:var(--r-lg);padding:18px;margin-bottom:10px;box-shadow:var(--card-sh);transition:box-shadow var(--dur)}
.dcard:hover{box-shadow:var(--sh-md)}
.d-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:3px}
.d-name{font-size:14px;font-weight:700}
.badge{font-size:10px;font-weight:600;padding:3px 10px;border-radius:99px;border:1px solid transparent}
.b-cc{background:var(--brand-soft);color:var(--brand);border-color:rgba(37,99,235,.15)}
.b-loan{background:var(--err-soft);color:var(--err);border-color:rgba(239,68,68,.15)}
.b-bnpl{background:var(--warn-soft);color:var(--warn);border-color:rgba(245,158,11,.15)}
.b-mort{background:var(--ok-soft);color:var(--ok);border-color:rgba(16,185,129,.15)}
.d-num{font-size:10px;color:var(--t3);margin-bottom:14px}
.d-amts{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:12px}
.d-rem{font-size:26px;font-weight:700;letter-spacing:-.5px;line-height:1}
.d-rl{font-size:10px;color:var(--t3);margin-bottom:4px}
.d-ps{text-align:end}
.d-pv{font-size:14px;font-weight:700;color:var(--ok)}
.d-pl{font-size:10px;color:var(--t3)}
.prog-t{height:5px;background:var(--muted);border-radius:99px;overflow:hidden}
.prog-f{height:100%;border-radius:99px;transition:width 1.2s cubic-bezier(.4,0,.2,1)}
/* ══ SPEND ══ */
.sitem{display:flex;align-items:center;gap:12px;padding:13px 14px;background:var(--surf);border:1px solid var(--bd);border-radius:var(--r-lg);margin-bottom:8px;cursor:pointer;transition:all var(--dur);box-shadow:var(--card-sh)}
.sitem:hover{background:var(--hover);border-color:var(--bd2)}.sitem:active{transform:scale(.98)}
.s-em{width:42px;height:42px;border-radius:var(--r-md);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
.s-inf{flex:1;min-width:0}
.s-n{font-size:14px;font-weight:600;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.s-m{font-size:11px;color:var(--t3)}
.s-r{text-align:end;flex-shrink:0}
.s-a{font-size:15px;font-weight:700}
.s-c{font-size:10px;color:var(--t3);margin-top:2px}
/* ══ BUDGET ══ */
.bitem{background:var(--surf);border:1px solid var(--bd);border-radius:var(--r-lg);padding:14px 16px;margin-bottom:8px;box-shadow:var(--card-sh)}
.b-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.b-nm{font-size:13px;font-weight:600}
.b-ns{font-size:12px;color:var(--t2)}
.b-ns strong{color:var(--t1);font-weight:700}
.b-tr{height:6px;background:var(--muted);border-radius:99px;overflow:hidden}
.b-fl{height:100%;border-radius:99px;transition:width 1s var(--ease)}
/* ══ SAVINGS ══ */
.sav-card{background:var(--surf);border:1px solid var(--bd);border-radius:var(--r-xl);padding:20px;margin-bottom:10px;box-shadow:var(--card-sh)}
.sv-hd{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px}
.sv-ttl{font-size:15px;font-weight:700;margin-bottom:3px}
.sv-sub{font-size:11px;color:var(--t2)}
.sv-pct{font-size:30px;font-weight:700;color:var(--ok)}
.sv-bt{height:10px;background:var(--muted);border-radius:99px;overflow:hidden;margin-bottom:12px}
.sv-bf{height:100%;border-radius:99px;background:linear-gradient(90deg,var(--ok),#34D399);transition:width 1.2s cubic-bezier(.4,0,.2,1)}
[dir=rtl] .sv-bf{background:linear-gradient(270deg,var(--ok),#34D399)}
.sv-st{display:flex;justify-content:space-between;font-size:12px;color:var(--t2)}
.sv-st strong{color:var(--t1);font-weight:600}
/* ══ HISTORY ══ */
.hm{display:flex;align-items:center;justify-content:space-between;padding:13px 16px;background:var(--surf);border:1px solid var(--bd);border-radius:var(--r-lg);margin-bottom:8px;cursor:pointer;transition:all var(--dur);box-shadow:var(--card-sh)}
.hm:hover{background:var(--hover);border-color:var(--bd2)}
.hm-n{font-size:14px;font-weight:700}
.hm-s{font-size:11px;color:var(--t2);margin-top:2px}
.hm-r{text-align:end}
.hm-v{font-size:15px;font-weight:700}
.hm-a{font-size:12px;color:var(--t3);margin-top:3px}
/* ══ PROFILE ══ */
.pcard{background:var(--surf);border:1px solid var(--bd);border-radius:var(--r-xl);padding:22px;margin-bottom:14px;box-shadow:var(--card-sh);text-align:center}
.p-av{width:66px;height:66px;border-radius:50%;background:var(--brand);display:flex;align-items:center;justify-content:center;font-size:26px;color:#fff;font-weight:700;margin:0 auto 12px;box-shadow:var(--sh-brand)}
.p-nm{font-size:18px;font-weight:700;margin-bottom:4px}
.p-sb{font-size:13px;color:var(--t2)}
.set-row{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;background:var(--surf);border:1px solid var(--bd);border-radius:var(--r-lg);margin-bottom:8px;cursor:pointer;transition:all var(--dur);box-shadow:var(--card-sh)}
.set-row:hover{background:var(--hover)}.set-row:active{transform:scale(.98)}
.set-l{display:flex;align-items:center;gap:12px}
.set-ic{font-size:18px}
.set-t{font-size:14px;font-weight:600}
.set-s{font-size:11px;color:var(--t2);margin-top:1px}
.set-arr{font-size:12px;color:var(--t3)}
.tog{width:44px;height:24px;border-radius:99px;background:var(--bd2);position:relative;cursor:pointer;transition:background var(--dur);border:none;flex-shrink:0}
.tog.on{background:var(--brand)}
.tog::after{content:'';position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:#fff;transition:left var(--dur)}
.tog.on::after{left:23px}
[dir=rtl] .tog::after{left:auto;right:3px}
[dir=rtl] .tog.on::after{left:auto;right:23px}
/* ══ FAB ══ */
.fab-wrap{position:fixed;bottom:0;left:0;right:0;padding:12px 16px calc(var(--safe-b)+12px);background:linear-gradient(transparent,var(--bg) 45%);z-index:60;pointer-events:none}
.fab{pointer-events:all;width:100%;height:58px;background:var(--brand);border:none;border-radius:var(--r-xl);color:#fff;font-size:16px;font-weight:700;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:10px;cursor:pointer;box-shadow:var(--sh-brand);transition:all var(--dur)}
.fab:hover{background:var(--brand-l);transform:translateY(-1px)}.fab:active{transform:scale(.97)}
/* ══ MODAL ══ */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:200;display:flex;align-items:flex-end;opacity:0;pointer-events:none;transition:opacity var(--dur) var(--ease);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
.overlay.on{opacity:1;pointer-events:all}
.sheet{background:var(--surf);border-radius:var(--r-2xl) var(--r-2xl) 0 0;padding:20px 18px calc(var(--safe-b)+20px);width:100%;transform:translateY(100%);transition:transform .35s var(--ease);max-height:92vh;overflow-y:auto}
.overlay.on .sheet{transform:translateY(0)}
.handle{width:36px;height:4px;background:var(--bd2);border-radius:99px;margin:0 auto 20px}
.m-ttl{font-size:18px;font-weight:700;margin-bottom:18px;text-align:center}
/* ══ NUMPAD ══ */
.amt-disp{text-align:center;margin-bottom:16px}
.amt-big{font-size:52px;font-weight:300;letter-spacing:-2px;color:var(--t3);min-height:62px;transition:color var(--dur)}
.amt-big.hv{color:var(--brand);font-weight:700}
.amt-cur{font-size:13px;color:var(--t3)}
.cats{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-bottom:14px}
.cbt{padding:10px 3px;border:1.5px solid var(--bd);background:var(--muted);border-radius:var(--r-md);color:var(--t2);font-size:11px;font-weight:600;font-family:inherit;cursor:pointer;text-align:center;transition:all var(--dur)}
.cbt .ci{font-size:19px;display:block;margin-bottom:3px}
.cbt.sel{background:var(--brand-soft);border-color:var(--brand);color:var(--brand)}
.cbt:active{transform:scale(.91)}
.numpad{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-bottom:14px}
.nbtn{height:58px;background:var(--muted);border:1px solid var(--bd);border-radius:var(--r-md);color:var(--t1);font-size:22px;font-weight:400;font-family:inherit;cursor:pointer;transition:all var(--dur);display:flex;align-items:center;justify-content:center}
.nbtn:hover{background:var(--hover);border-color:var(--bd2)}.nbtn:active{background:var(--press);transform:scale(.9)}
.nbtn.del{color:var(--t2);font-size:18px}.nbtn.z2{grid-column:span 2}
.sub-btn{width:100%;height:56px;background:var(--brand);border:none;border-radius:var(--r-lg);color:#fff;font-size:16px;font-weight:700;font-family:inherit;cursor:pointer;box-shadow:var(--sh-brand);transition:all var(--dur)}
.sub-btn:hover{background:var(--brand-l)}.sub-btn:active{transform:scale(.98)}.sub-btn:disabled{opacity:.35;cursor:not-allowed;transform:none}
