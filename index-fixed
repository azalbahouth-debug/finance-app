// ═══════════════════════════════════════════
// SHEETS SYNC
// ═══════════════════════════════════════════
function setSyncState(st){
  const btn=$('sync-btn'),bar=$('sync-bar');
  if(btn)btn.classList.toggle('spin',st==='loading');
  if(bar){bar.classList.remove('load','done');if(st==='loading')bar.classList.add('load');if(st==='done')bar.classList.add('done');}
}
async function doSync(){
  if(!CFG.sheetId||!CFG.apiKey){renderAll();toast(LANG==='ar'?'📊 بيانات تجريبية':'📊 Demo data');return;}
  setSyncState('loading');
  try{
    const RANGES=['SETTINGS!C9','SETTINGS!C13','MAIN!D9','MAIN!F9','MAIN!H9','MAIN!J9','MAIN!N9',"'DEBT ENGINE'!D6:D14","'DEBT ENGINE'!E6:E14","'DEBT ENGINE'!F6:F14"];
    const q=RANGES.map(r=>'ranges='+encodeURIComponent(r)).join('&');
    const res=await fetch(`https://sheets.googleapis.com/v4/spreadsheets/${CFG.sheetId}/values:batchGet?${q}&key=${CFG.apiKey}`,{signal:AbortSignal.timeout(10000)});
    if(!res.ok)throw new Error(res.status);
    const j=await res.json();const vr=j.valueRanges;
    const v=i=>{const r=vr[i]?.values;return r?.[0]?.[0]?parseFloat(r[0][0])||null:null;};
    const va=i=>(vr[i]?.values||[]).map(r=>parseFloat(r[0])||0);
    const dbR=va(9);const td=dbR.reduce((a,b)=>a+b,0);
    DATA={...DD,salary:v(0)||DD.salary,emergency:v(1)||DD.emergency,spent:v(3)||DD.spent,debtPaid:v(4)||DD.debtPaid,savedAmt:v(5)||DD.savedAmt,extra:v(6)||DD.extra,totalDebt:td,netWorth:DD.assets-td,debts:DD.debts.map((db,i)=>({...db,rem:dbR[i]??db.rem,paid:va(8)[i]??db.paid}))};
    ss(K.data,DATA);setSyncState('done');renderAll();toast('✅ '+(LANG==='ar'?'تم التحديث':'Synced'));
  }catch(e){setSyncState('');toast('⚠️ '+(LANG==='ar'?'خطأ في الاتصال':'Connection error'));}
}

async function appendToSheets(row){
  if(!CFG.sheetId||!CFG.apiKey)return false;
  try{
    const url=`https://sheets.googleapis.com/v4/spreadsheets/${CFG.sheetId}/values/${encodeURIComponent("'ENTRY LOG'!B:F")}:append?valueInputOption=USER_ENTERED&key=${CFG.apiKey}`;
    const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({values:[row]}),signal:AbortSignal.timeout(8000)});
    return r.ok;
  }catch{return false;}
}

