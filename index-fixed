// MODALS
// ═══════════════════════════════════════════
function openModal(id){$(id).classList.add('on');document.body.style.overflow='hidden';}
function closeModal(id){$(id).classList.remove('on');document.body.style.overflow='';}

let _amt='',_cat=null,_cats=[];
function openLog(){
  _amt='';_cat=null;
  const d=$('amt-d');if(d){d.textContent=LANG==='ar'?'٠':'0';d.classList.remove('hv');}
  const b=$('log-btn');if(b){b.disabled=true;b.textContent=t('logBtn');}
  document.querySelectorAll('.cbt').forEach(b=>b.classList.remove('sel'));
  buildCats();openModal('log-modal');
}
function buildCats(){
  _cats=T[LANG].cats;
  hx('cats-grid',_cats.map(c=>`<button class="cbt" id="c-${c.id}" onclick="selCat('${c.id}')"><span class="ci">${c.e}</span>${c.l}</button>`).join(''));
}
function selCat(id){
  _cat=id;document.querySelectorAll('.cbt').forEach(b=>b.classList.remove('sel'));
  const el=$('c-'+id);if(el)el.classList.add('sel');chkLog();
}
const NM={'0':'٠','1':'١','2':'٢','3':'٣','4':'٤','5':'٥','6':'٦','7':'٧','8':'٨','9':'٩','.':'٫'};
function np(n){if(n==='.'&&_amt.includes('.'))return;if(_amt.length>=7)return;_amt+=n;updAmt();chkLog();}
function nd(){_amt=_amt.slice(0,-1);updAmt();chkLog();}
function updAmt(){
  const d=$('amt-d');if(!d)return;
  const s=LANG==='ar'?(_amt.split('').map(c=>NM[c]||c).join('')||'٠'):(_amt||'0');
  d.textContent=s;d.classList.toggle('hv',_amt.length>0);
}
function chkLog(){const b=$('log-btn');if(b)b.disabled=!(parseFloat(_amt)>0&&_cat);}

async function submitLog(){
  const amt=parseFloat(_amt);const cat=_cats.find(c=>c.id===_cat);if(!amt||!cat)return;
  const b=$('log-btn');if(b){b.textContent='⏳';b.disabled=true;}
  const entry={id:Date.now()+'',name:cat.l,cat_ar:cat.l,cat_en:cat.l,e:cat.e,bg:cat.bg,amt,date:new Date().toISOString().split('T')[0],mo:CUR_MONTH,yr:CUR_YEAR};
  let ok=false;
  if(!DEMO){
    EXPENSES.unshift(entry);ss(K.exp,EXPENSES);
    const d=new Date();const ds=`${d.getDate()}/${d.getMonth()+1}/${d.getFullYear()}`;
    ok=await appendToSheets([ds,'Spending',amt,cat.l,cat.l+' — App']);
  }
  closeModal('log-modal');if(b){b.textContent=t('logBtn');b.disabled=false;}
  toast(ok?`✅ ${t('cur')}${fmt(amt)} — ${t('logSheets')}`:`✅ ${t('cur')}${fmt(amt)} — ${t('logLocal')}`);
  renderAll();
}

function delExp(id){
  if(DEMO){toast(LANG==='ar'?'وضع التجربة':'Demo mode');return;}
  if(!confirm(LANG==='ar'?'حذف هذا المصروف؟':'Delete this expense?'))return;
  EXPENSES=EXPENSES.filter(e=>e.id!==id);ss(K.exp,EXPENSES);renderSpending();
}

// Sheets setup modal
function openSheets(){
  const si=$('inp-sid'),ak=$('inp-akey');
  if(si)si.value=CFG.sheetId||'';if(ak)ak.value=CFG.apiKey||'';
  openModal('sh-modal');
}
function saveSheets(){
  const sid=$('inp-sid')?.value.trim(),key=$('inp-akey')?.value.trim();
  if(!sid||!key){toast('⚠️ '+(LANG==='ar'?'أدخل البيانات':'Enter credentials'));return;}
  CFG={sheetId:sid,apiKey:key};ss(K.cfg,CFG);closeModal('sh-modal');toast(t('connected'));doSync();
}

// ═══════════════════════════════════════════
// EXPORT
// ═══════════════════════════════════════════
function exportCSV(){
  const rows=[['Date','Amount','Category','Name','Month','Year'],...(DEMO?DE:EXPENSES).map(e=>[e.date,e.amt,e.cat_en||e.cat_ar,e.name,e.mo,e.yr])];
  const csv=rows.map(r=>r.map(c=>`"${c}"`).join(',')).join('\n');
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));a.download='maliaty_expenses.csv';a.click();
}

